    {
      "id": "chain",
      "type": "CodeBlock",
      "params": {
        "code": "# Catena in rilievo sul fianco del dado (nota zz-note-probe/g1#a2, in verde):\n# anelli orientati verso l'esterno, uniti da barrette, tutto intorno.\nlinks = 6        #@param int min=3 max=16\nring_r = 2.0     #@param float min=0.8 max=3.5 step=0.1\nwire = 0.7       #@param float min=0.3 max=1.5 step=0.1\nrelief = 0.6     #@param float min=0.2 max=1.5 step=0.1\nR = 8.0          #@param float min=4 max=30 step=0.5\nz0 = -0.3        #@param float min=-4 max=4 step=0.1\nimport math\nsink = 1.2                       # quanto entra nel dado: deve restare sepolta anche ai bordi\nt = relief + sink\nrc = R + relief - t / 2          # centro radiale di anelli e barrette\nhalf = math.pi / links\nL = max(2 * (rc * math.sin(half) - ring_r + wire / 2), 0.5)\nresult = None\nfor k in range(links):\n    ring = Cylinder(ring_r, t) - Cylinder(ring_r - wire, t + 1)\n    ring = Rot(0, 0, 360 * k / links) * Pos(rc, 0, z0) * Rot(0, 90, 0) * ring\n    bar = Rot(0, 0, 360 * (k + 0.5) / links) * Pos(rc, 0, z0) * Box(t, L, wire)\n    result = ring + bar if result is None else result + ring + bar\n"
      },
      "position": [
        80.0,
        1661.0
      ],
      "parent": null,
      "title": "Catena dado"
    },
