    {
      "id": "coniglio",
      "type": "CodeBlock",
      "params": {
        "code": "# ---- parametri ----\nfillet_r = 2.0      #@param float min=0 max=4\neye_r = 3.0         #@param float min=1 max=5\neye_dx = 8.5        #@param float min=4 max=12\neye_z = 3.5         #@param float min=-5 max=8\near_h = 16.0        #@param float min=6 max=30\near_w = 7.0         #@param float min=3 max=12\near_t = 3.5         #@param float min=2 max=8\npaw_r = 3.5         #@param float min=1 max=6\n\n# ---- corpo (il cubo in ingresso, centrato) ----\nbody = in_0 if in_0 is not None else Box(30, 30, 20)\nbb = body.bounding_box()\nW, D, H = bb.size.X, bb.size.Y, bb.size.Z\nyf = bb.min.Y          # faccia frontale (il muso)\nzt = bb.max.Z          # faccia superiore\nzb = bb.min.Z          # base\nif fillet_r > 0:\n    body = fillet(body.edges(), fillet_r)\n\n# ---- orecchie ----\nears = []\nfor sx in (-1, 1):\n    ear = Box(ear_w, ear_t, ear_h)\n    ear = fillet(ear.edges().group_by(Axis.Z)[-1].filter_by(Axis.Y), ear_w / 2 - 0.05)   # punta arrotondata\n    inner = Pos(0, -ear_t / 2, 0.8) * Box(ear_w * 0.45, 1.6, ear_h * 0.6)  # interno orecchio\n    ear = ear - inner\n    ear = Pos(sx * eye_dx, yf + D * 0.3, zt + ear_h / 2 - 1.0) * ear\n    ears.append(ear)\nbody = body + ears\n\n# ---- occhi (in rilievo) con pupilla incisa ----\nfor sx in (-1, 1):\n    eye = Pos(sx * eye_dx, yf, eye_z) * Rot(90, 0, 0) * Cylinder(eye_r, 2.0)\n    body = body + eye\n    pupil = Pos(sx * eye_dx - 0.8, yf - 1.0, eye_z) * Rot(90, 0, 0) * Cylinder(eye_r * 0.4, 2.0)\n    body = body - pupil\n\n# ---- bocca: sorriso inciso + denti ----\nsmile_c = eye_z - 1.5\nring = Pos(0, yf, smile_c) * Rot(90, 0, 0) * (Cylinder(6.5, 2.4) - Cylinder(5.6, 2.4))\nlower = Pos(0, yf, smile_c - 6.0) * Box(14.0, 2.4, 8.0)\nbody = body - (ring & lower)\ntick = Pos(0, yf, smile_c - 4.5) * Box(0.9, 2.4, 3.0)       # il \"filtro\" sotto il naso\nbody = body - tick\nteeth = [Pos(sx * 1.4, yf - 0.6, smile_c - 7.6) * Box(2.4, 2.2, 3.2) for sx in (-1, 1)]\nbody = body + teeth\n\n# ---- zampette sui fianchi ----\npaws = []\nfor sx in (-1, 1):\n    for py in (yf + 5.0, yf + D - 6.5):\n        s = Pos(sx * W / 2, py, zb) * Sphere(paw_r)\n        paws.append(s & (Pos(sx * W / 2, py, zb + paw_r) * Box(2 * paw_r, 2 * paw_r, 2 * paw_r)))\nbody = body + paws\n\nresult = body\n"
      },
      "position": [
        380,
        4863
      ],
      "parent": null,
      "title": "Coniglietto cube"
    },
    {
      "id": "bic_forme",
      "type": "CodeBlock",
      "params": {
        "code": "import math\n# ---- parametri ----\nr_out = 12.0        #@param float min=5 max=50\nz_bottom = -15.0    #@param float min=-50 max=0\nfloor_t = 2.0       #@param float min=0.5 max=10\nhole_r = 1.5        #@param float min=0.5 max=5\nhole_ring = 5.5     #@param float min=1 max=20\nn_holes = 4         #@param int min=1 max=12\nshape_size = 13.0   #@param float min=4 max=20\nshape_z = 1.0       #@param float min=-10 max=10\n\nbody = in_0\n\n# ---- fori sul fondo, equidistanti ----\nholes = [Pos(hole_ring * math.cos(math.radians(-90 + i * 360 / n_holes)),\n             hole_ring * math.sin(math.radians(-90 + i * 360 / n_holes)),\n             z_bottom + floor_t / 2) * Cylinder(hole_r, floor_t + 2)\n         for i in range(n_holes)]\nbody = body - holes\n\n# ---- sagome sui lati (piano XZ, poi estruse in direzione -Y) ----\ns = shape_size\ndef profile(kind):\n    if kind == \"square\":\n        return Rectangle(s * 0.85, s * 0.85)\n    if kind == \"circle\":\n        return Circle(s / 2)\n    if kind == \"triangle\":\n        return RegularPolygon(s * 0.58, 3, rotation=90)\n    # cuore: due cerchi + triangolo verso il basso\n    r = s * 0.27\n    lobes = Pos(-r * 0.9, r * 0.6) * Circle(r) + Pos(r * 0.9, r * 0.6) * Circle(r)\n    tip = Polygon((-r * 1.82, r * 0.25), (r * 1.82, r * 0.25), (0, -s * 0.55))\n    return lobes + tip\n\ndef cutter(kind, angle):\n    # profilo sul piano XZ (normale -Y), estruso dall'asse fino oltre la parete\n    sk = Plane.XZ * profile(kind)\n    tool = extrude(sk, amount=r_out + 3)          # verso -Y\n    return Rot(0, 0, angle) * (Pos(0, 0, shape_z) * tool)\n\ntools = [cutter(\"square\", 0), cutter(\"triangle\", 90), cutter(\"circle\", 180), cutter(\"heart\", 270)]\nbody = body - tools\nresult = body\n"
      },
      "position": [
        980,
        4206
      ],
      "parent": null,
      "title": "Fori fondo + sagome"
    }
