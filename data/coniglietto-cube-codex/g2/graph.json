    {
      "id": "coniglio",
      "type": "CodeBlock",
      "params": {
        "code": "# ---- testa cubica e orecchie ----\nresult = in_0\nfor x in (-9,9):\n    result = result + Pos(x,-7,18.25) * Box(6,8,17.5)\n    result = result + Pos(x,-7,27) * Cylinder(3,8,rotation=(90,0,0))\n# ---- occhi incavati ----\nfor x in (-9,9):\n    result = result - Pos(x,-15,3.5) * Cylinder(3,2,rotation=(90,0,0))\n    result = result - Pos(x-0.5,-13.8,3.4) * Cylinder(0.9,1.4,rotation=(90,0,0))\n# ---- sorriso inciso ----\nupper = [(i*0.8,-6.5+2.2*(i/9)**2+0.35) for i in range(-9,10)]\nlower = [(i*0.8,-6.5+2.2*(i/9)**2-0.35) for i in range(9,-10,-1)]\nsmile = Plane.XZ.offset(14.2) * Polygon(*(upper+lower),align=None)\nresult = result - extrude(smile,amount=2,dir=(0,-1,0))\n# ---- dentini ----\nfor x in (-1.2,1.2):\n    result = result - Pos(x,-15,-8) * Box(2,2,3)\n# ---- intagli ad arco per le zampe ----\nfor x in (-15,15):\n    for y in (-10,10):\n        result = result - Pos(x,y,-8) * Cylinder(3.0,2,rotation=(0,90,0))"
      },
      "position": [
        380,
        4863
      ],
      "parent": null,
      "preview": false,
      "title": "Coniglietto cube"
    },
    {
      "id": "aperture_bicchiere",
      "type": "CodeBlock",
      "params": {
        "code": "# ---- fondo forato ----\nresult = in_0\nfor x,y in ((-6,0),(6,0),(0,-6),(0,6)):\n    result = result - Pos(x,y,-14) * Cylinder(1.7,4)\n# ---- aperture laterali equidistanti ----\nsquare = [(-6,-10),(6,-10),(6,9),(-6,9)]\ntriangle = [(-7,-10),(7,-10),(0,9)]\nhexagon = [(-6,-5),(-3,-10),(3,-10),(6,-5),(6,4),(3,9),(-3,9),(-6,4)]\nheart = [(-7,3),(-6,7),(-3,9),(-1,8),(0,5),(1,8),(3,9),(6,7),(7,3),(6,0),(0,-10),(-6,0)]\nfor angle, coords in ((0,square),(90,triangle),(180,hexagon),(270,heart)):\n    profile = Plane.XZ.offset(8) * Polygon(*coords, align=None)\n    cutter = Rot(0,0,angle) * extrude(profile, amount=6)\n    result = result - cutter"
      },
