    {
      "id": "sorriso_cb",
      "type": "CodeBlock",
      "params": {
        "code": "# ---- sorriso del coniglietto (incaso nel muso) ----\nimport math\nR_est = 8.2      #@param min=5 max=12\nR_int = 6.9      #@param min=3 max=11\narco  = 117.0    #@param min=40 max=170\nz_c   = 2.3      #@param min=-8 max=8\nprof  = 2.0      #@param min=0.5 max=5\n\nhalf = arco / 2.0\ntry:\n    faccia = (Sector(R_est, 270 - half, 270 + half)\n              - Sector(R_int, 270 - half, 270 + half))\nexcept Exception:\n    n = 33\n    def _pts(r, sgn):\n        return [(r * math.cos(math.radians(270 + sgn * half - sgn * arco * i / (n - 1))),\n                 r * math.sin(math.radians(270 + sgn * half - sgn * arco * i / (n - 1))))\n                for i in range(n)]\n    faccia = make_face(Polyline(*_pts(R_est, 1), *_pts(R_int, -1), close=True))\nresult = Pos(0, -15, z_c) * Rot(Axis.X, 90) * extrude(faccia, amount=-prof)\n"
      },
      "position": [
        80.0,
        9340.103469300651
      ],
      "parent": null,
      "title": "Sorriso inciso"
    }
