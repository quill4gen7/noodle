    {
      "id": "intagli_bic",
      "type": "CodeBlock",
      "params": {
        "code": "import build123d as B\nimport math\n\n# ---- parametri intagli laterali ----\nzc     = -1.5   #@param float min=-12 max=10 step=0.5\nprof   = 9.0    #@param float min=3 max=14 step=0.5\nr_est  = 12.0\n\n# ---- fori sul fondo ----\nr_foro = 1.6    #@param float min=0.5 max=4 step=0.1\nd_foro = 6.0    #@param float min=3 max=8.5 step=0.5\nn_fori = 4      #@param int min=2 max=8\n\npl = B.Plane(origin=(0, r_est + 5, 0), x_dir=(1, 0, 0), z_dir=(0, -1, 0))\n\ndef cutter(draw_fn):\n    with B.BuildPart() as bp:\n        with B.BuildSketch(pl):\n            with B.Locations((0, zc)):\n                draw_fn()\n        B.extrude(amount=prof)\n    return bp.part\n\n# ---- profilo rettangolo ----\ndef c_rect():\n    B.Rectangle(12.0, 15.0)\n\n# ---- profilo triangolo ----\ndef c_tri():\n    B.RegularPolygon(8.0, 3, rotation=90)\n\n# ---- profilo esagono ----\ndef c_hex():\n    B.RegularPolygon(7.5, 6)\n\n# ---- profilo cuore ----\ndef c_heart():\n    with B.Locations((-3.1, 1.8), (3.1, 1.8)):\n        B.Circle(3.5)\n    B.Polygon((-6.2, 1.4), (6.2, 1.4), (0.0, -7.8))\n\n# ---- i 4 intagli, equidistanti (90 gradi) ----\ncutters = [\n    cutter(c_rect ).rotate(B.Axis.Z, 180),\n    cutter(c_tri  ).rotate(B.Axis.Z, -90),\n    cutter(c_hex  ),\n    cutter(c_heart).rotate(B.Axis.Z, 90),\n]\n\n# ---- fori equidistanti nel fondo ----\nfor k in range(n_fori):\n    a = math.radians(k * 360.0 / n_fori)\n    cutters.append(B.Pos(d_foro * math.cos(a), d_foro * math.sin(a), -14.0) * B.Cylinder(r_foro, 6.0))\n\nresult = B.Compound(children=cutters)\n"
      },
      "position": [
        80.0,
        4610.411764705876
      ],
      "parent": null,
      "title": "Intagli e fori fondo"
    },
